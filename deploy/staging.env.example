# Copy to deploy/staging.env and fill in for a separate project. Nothing here is inherited from production.
PROJECT=your-staging-project
REGION=asia-south1
SERVICE=collab-market
SITE=https://your-staging-project.web.app
RECAPTCHA_SITE_KEY=
APPCHECK=monitor
SEED_DEMO=0
MIN_INSTANCES=0
MAX_INSTANCES=4
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
ARMOR_LOCATION=asia-south1
MODEL_ARMOR_FAIL_MODE=open
POLICY_JSON={}
