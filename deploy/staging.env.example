# Copy to deploy/staging.env and fill in for a separate project. Nothing here is inherited from production.
PROJECT=your-staging-project
REGION=asia-south1
SERVICE=collab-market
SITE=https://your-staging-project.web.app
RECAPTCHA_SITE_KEY=
APPCHECK=monitor
SEED_DEMO=0
MIN_INSTANCES=0
MAX_INSTANCES=4
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
ARMOR_LOCATION=asia-south1
MODEL_ARMOR_FAIL_MODE=open
POLICY_JSON={}
# Optional: copy commerce events to this BigQuery dataset and forecast demand (scripts/setup-bigquery.sh; docs/BIGQUERY.md). Empty: off.
BQ_DATASET=
# Optional: a private Cloud Storage bucket for listing photos (empty: photos are kept in the database).
PHOTO_BUCKET=
# Optional: Google Calendar linking with the owner's Google sign-in. Create an OAuth client (Web application) in the
# project with redirect URI $SITE/api/google/calendar/callback and store it as the Secret Manager secrets
# google-oauth-client-id and google-oauth-client-secret; deploy.sh passes them through. Absent: iCal address only.
